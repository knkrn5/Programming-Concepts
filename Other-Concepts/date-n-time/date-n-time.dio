                <mxCell id="m5LNB8FHbh89lhIAg1ka-10" parent="m5LNB8FHbh89lhIAg1ka-8" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;ol&gt;&lt;li&gt;Unix time” (seconds since 1970-01-01 UTC) , also called &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 0, 102));&quot;&gt;Unix epoch&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 0, 102));&quot;&gt;&lt;strong style=&quot;color: rgb(192, 192, 192); scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); background-color: rgb(27, 29, 30);&quot;&gt;Windows FILETIME&lt;/strong&gt;&lt;span style=&quot;color: rgb(255, 255, 255); background-color: rgb(27, 29, 30);&quot;&gt;: 100-nanosecond ticks since 1601-01-01 UTC.&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 0, 102));&quot;&gt;&lt;span style=&quot;color: rgb(255, 255, 255); background-color: rgb(27, 29, 30);&quot;&gt;&lt;strong style=&quot;color: rgb(192, 192, 192); scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); background-color: rgb(27, 29, 30);&quot;&gt;Apple/Cocoa time&lt;/strong&gt;&lt;span style=&quot;color: rgb(255, 255, 255); background-color: rgb(27, 29, 30);&quot;&gt;: seconds since 2001-01-01.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
