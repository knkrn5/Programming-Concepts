                <mxCell id="2" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;PM2&lt;/font&gt;&lt;/b&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;" parent="1" vertex="1">
