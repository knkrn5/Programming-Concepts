                <mxCell id="4" value="Process Manager for node.js" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;rounded=0;" parent="3" vertex="1">
                    <mxGeometry y="30" width="300" height="30" as="geometry"/>
