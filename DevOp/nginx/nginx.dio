                <mxCell id="2" value="&lt;b&gt;&lt;font style=&quot;font-size: 24px;&quot;&gt;NGINX&lt;/font&gt;&lt;/b&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#dae8fc;gradientColor=#7ea6e0;strokeColor=#6c8ebf;" parent="1" vertex="1">
                    <mxGeometry x="260" y="110" width="130" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="what nginx can do" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="170" y="-370" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="1. Serve static files" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="3" vertex="1">
                    <mxGeometry y="30" width="300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="2. Reverse proxy" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="3" vertex="1">
                    <mxGeometry y="60" width="300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="3. Load balancing" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="3" vertex="1">
                    <mxGeometry y="90" width="300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="nginx confgis" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#fad9d5;strokeColor=#ae4132;" parent="1" vertex="1">
                    <mxGeometry x="420" y="280" width="360" height="510" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="1. config number of worker process&lt;div&gt;&lt;ol&gt;&lt;li&gt;config the connection each worker, can open&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="12" vertex="1">
                    <mxGeometry y="30" width="360" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="21" value="2. Server static files: -&amp;nbsp;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Config the MIME type of the file extension,&amp;nbsp;&lt;/li&gt;&lt;li&gt;serve custom error page&lt;/li&gt;&lt;li&gt;&lt;br&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="12" vertex="1">
                    <mxGeometry y="90" width="360" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="3. Config if we want to show directory listing of the folder path" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="12" vertex="1">
                    <mxGeometry y="190" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="23" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;4. &lt;b&gt;PER SERVER CONFIGS: -&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;a) listen of specific IP and PORT&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;b) now serve any file, message in that IP and PORT, with custom status code&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;b) can config the routing for specific paths, (The &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 51, 102));&quot;&gt;order of locaiton path mattters&lt;/span&gt;)&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;the path patterns can &quot;prefix match&quot;, &quot;exact match&quot;, &quot;case-senistive or insensitive&quot; and regrex based&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;for one path, we can also try multiple files, the once that succeeds first get served&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="12" vertex="1">
                    <mxGeometry y="240" width="360" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="24" value="5. can Config whether to serve the file directly from OS, default is from nginx worker processs" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="12" vertex="1">
                    <mxGeometry y="460" width="360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="later" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="1030" y="140" width="390" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="18" value="&lt;code&gt;index&lt;/code&gt; is only used when nginx resolves a request to a &lt;strong&gt;directory&lt;/strong&gt;, and it appends a filename to try inside that directory.&amp;nbsp;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="17" vertex="1">
                    <mxGeometry y="30" width="390" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="19" value="" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="17" vertex="1">
                    <mxGeometry y="100" width="390" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="Problem(Why to use nginx)" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#f5f5f5;gradientColor=#b3b3b3;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="-290" y="110" width="370" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="1.&amp;nbsp;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="8" vertex="1">
                    <mxGeometry y="30" width="370" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="25" value="&lt;span style=&quot;color: rgb(66, 66, 66); font-family: Poppins, &amp;quot;Noto Color Emoji&amp;quot;, sans-serif; font-size: 14px; text-align: start; white-space: pre-wrap; background-color: rgb(255, 255, 255);&quot;&gt;U can also do redirection using nginx: - &lt;br/&gt;&lt;br/&gt;1. HTTP → HTTPS redirect (common once you add SSL)&lt;br/&gt;2. Redirect www ↔ non-www (same idea, different match)&lt;br/&gt;3. Redirect to a different domain/path (true HTTP redirect, browser-visible)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="360" width="610" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="26" value="&lt;strong&gt;Your header won&#39;t show even if the backend were up&lt;/strong&gt; — &lt;code&gt;add_header&lt;/code&gt; in nginx only applies to&lt;div&gt;&amp;nbsp;responses with these status codes by default: 200, 201, 204, 206, 301, 302, 303, 304, 307, 308. It&#39;s&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;strong&gt;skipped on error responses&lt;/strong&gt; (4xx/5xx) unless you add the &lt;code&gt;always&lt;/code&gt; parameter:&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1010" y="380" width="560" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="27" value="variables in nginx: -&lt;div&gt;we some predefined variables&lt;/div&gt;&lt;div&gt;we can also create custom headers&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;code data-end=&quot;413&quot; data-start=&quot;408&quot;&gt;set&lt;/code&gt; is valid in &lt;strong data-end=&quot;462&quot; data-start=&quot;426&quot;&gt;&lt;code data-end=&quot;436&quot; data-start=&quot;428&quot;&gt;server&lt;/code&gt; and &lt;code data-end=&quot;451&quot; data-start=&quot;441&quot;&gt;location&lt;/code&gt;&amp;nbsp;contexts&lt;/strong&gt;, but &lt;strong data-end=&quot;490&quot; data-start=&quot;468&quot;&gt;not &lt;code data-end=&quot;480&quot; data-start=&quot;474&quot;&gt;http&lt;/code&gt; context&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;# ✅ map is allowed in http. *(&lt;span style=&quot;background-color: transparent;&quot;&gt;So the rule of thumb: &lt;/span&gt;&lt;strong style=&quot;background-color: transparent;&quot;&gt;&lt;code&gt;set&lt;/code&gt; →&amp;nbsp;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;strong style=&quot;background-color: transparent;&quot;&gt;server/location/if only. &lt;code&gt;map&lt;/code&gt;/&lt;code&gt;geo&lt;/code&gt; → http block, for&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;strong style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp;defining reusable variables everywhere.&lt;/strong&gt;&lt;span style=&quot;color: rgb(192, 192, 192); background-color: transparent;&quot;&gt;)&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1100" y="510" width="400" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="28" value="type can be config&lt;br&gt;globally, per server,&amp;nbsp;&lt;div&gt;and per location path&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="790" y="385" width="140" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="29" value="&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th scope=&quot;col&quot;&gt;Need&lt;/th&gt;&lt;th scope=&quot;col&quot;&gt;Use&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;Simple static or computed value&lt;/td&gt;&lt;td&gt;&lt;code&gt;set&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Single conditional check&lt;/td&gt;&lt;td&gt;&lt;code&gt;set&lt;/code&gt; + &lt;code&gt;if&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Multiple pattern matches / lookup table&lt;/td&gt;&lt;td&gt;&lt;code&gt;map&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Value based on request headers, URI, args&lt;/td&gt;&lt;td&gt;&lt;code&gt;map&lt;/code&gt; (preferred)&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="1160" y="770" width="350" height="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>