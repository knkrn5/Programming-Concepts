                <mxCell id="6" value="&lt;h1&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;PNPM&lt;/font&gt;&lt;/b&gt;&lt;/h1&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f8cecc;gradientColor=#ea6b66;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="340" y="544" width="120" height="80" as="geometry"/>
