                </mxCell>
                <mxCell id="31" parent="130" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;span style=&quot;color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;View the pnpm config file in system (~/.config/pnpm/config.yaml)&lt;/span&gt;" vertex="1">
                    <mxGeometry height="40" width="380" y="270" as="geometry"/>
                </mxCell>
                <mxCell id="200" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;gradientColor=#7ea6e0;" value="&lt;b&gt;Pnpm Production setup&lt;/b&gt;" vertex="1">
                    <mxGeometry height="170" width="380" x="-710" y="501" as="geometry">
                        <mxRectangle height="30" width="110" x="-720" y="450" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="201" parent="200" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="1. Frozen-lockfile cmd: - similar as &quot;npm ci&quot;" vertex="1">
                    <mxGeometry height="60" width="380" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="202" parent="200" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="2.&amp;nbsp;" vertex="1">
                    <mxGeometry height="80" width="380" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="37" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=light-dark(#FFCCCC,#4C0099);strokeColor=#36393d;" value="&lt;b&gt;Extra Info&lt;/b&gt;" vertex="1">
                    <mxGeometry height="190" width="390" x="200" y="-380" as="geometry">
                        <mxRectangle height="30" width="110" x="170" y="-410" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="38" parent="37" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 102, 102));&quot;&gt;pnpm still has to download the tarball from the registry &lt;/span&gt;(npm registry doesn&#39;t let you fetch individual files from a package). It always downloads and unpacks the&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 102, 102));&quot;&gt; full tarball into memory/temp&lt;/span&gt;. But when it&#39;s time to &lt;strong&gt;write files into the store / link them into &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;node_modules&lt;/code&gt;&lt;/strong&gt;, that&#39;s where the dedup kicks in —&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 102, 102));&quot;&gt; unchanged files skip the write-to-disk step&lt;/span&gt; and &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 102, 102));&quot;&gt;just get relinked&lt;/span&gt;, and the actual &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;node_modules&lt;/code&gt; population is hardlinks either way, not copies. So the &lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(102, 0, 204));&quot;&gt;savings are mainly in &lt;/font&gt;&lt;/span&gt;&lt;strong&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(102, 0, 204));&quot;&gt;disk space&lt;/font&gt;&lt;/span&gt; and&lt;/span&gt; node_modules population speed&lt;/strong&gt;, &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(102, 0, 204));&quot;&gt;not network bandwidth&lt;/font&gt; (there are some registry-level tricks for reducing download size too, but that&#39;s separate from the store&#39;s content-addressing)." vertex="1">
                    <mxGeometry height="160" width="390" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="75" edge="1" parent="1" source="24" style="edgeStyle=none;html=1;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;flowAnimation=1;" target="21">
