                <mxCell id="18" style="edgeStyle=none;html=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;strokeWidth=5;flowAnimation=1;" parent="1" source="16" target="2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="45" value="&lt;ol style=&quot;box-sizing: border-box; border: 0px solid; margin: 8px 0px 12px; padding: 0px 0px 0px 2.25rem; list-style: outside decimal; -webkit-font-smoothing: antialiased; text-rendering: geometricprecision; font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: 14px; text-align: start; background-color: rgb(22, 22, 22);&quot;&gt;&lt;li style=&quot;box-sizing: border-box; border: 0px solid; margin: 0px 0px 8px; padding: 0px; -webkit-font-smoothing: antialiased; text-rendering: geometricprecision;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; border: 0px solid; margin: 0px; padding: 0px; display: inline; -webkit-font-smoothing: antialiased; text-rendering: geometricprecision;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(250, 250, 250), rgb(255, 255, 255)); background-color: light-dark(rgb(22, 22, 22), rgb(0, 0, 153));&quot;&gt;&lt;span style=&quot;box-sizing: border-box; border: 0px solid; margin: 0px; padding: 0px; -webkit-font-smoothing: antialiased; text-rendering: geometricprecision; color: rgb(250, 250, 250);&quot;&gt;Avoids huge flat directories&lt;/span&gt; — A single project can have tens of thousands of files; putting all blobs in one dir would make filesystem lookups slow (ext4/NTFS do linear or hashed scans of directory entries).&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="10" width="560" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="93" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="46" target="45" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="46" value="&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: light-dark(rgb(255, 255, 255), rgb(102, 0, 204)); font-size: 16px;&quot;&gt;f&lt;b style=&quot;&quot;&gt;ilesystem optimization called hash-based sharding or fan-out,&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 102, 51));&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font&gt;The hash is alway calculated for the files in a package while adding in store: -&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: light-dark(rgb(255, 255, 255), rgb(102, 0, 204)); font-size: 16px;&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;const hash&amp;nbsp; &amp;nbsp; = &quot;00cc06fe80fe136b07a2bcc082944...&quot;;&amp;nbsp; // j&lt;u&gt;ust computed from file bytes of a file&lt;/u&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;const dirName = hash.slice(0, 2);&amp;nbsp; &amp;nbsp;// &quot;00&quot;&amp;nbsp; &amp;lt;- &lt;u&gt;This file will go in this directory&lt;/u&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;const fileName = hash.slice(2);&amp;nbsp; &amp;nbsp; &amp;nbsp;// &lt;u&gt;rest of hash will be the name of that file&lt;/u&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;const fullPath = `store/v11/files/00/cc06fe80fe136b07a2bcc082944...`; // And it will be stored like this, So the &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 102, 0));&quot;&gt;full file hash is calculated as dir Hash + file Hash&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="-250" width="560" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="88" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;flowAnimation=1;" parent="1" source="79" target="39" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="-160" y="10" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
