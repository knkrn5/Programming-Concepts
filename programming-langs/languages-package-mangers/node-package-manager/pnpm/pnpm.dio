                <mxCell id="100" parent="89" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="2. No Package Duplication: -&amp;nbsp; see npm (&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 0, 102));&quot;&gt;npm.svg&lt;/span&gt;)" vertex="1">
                    <mxGeometry height="50" width="440" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="211" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;gradientColor=#ffd966;" value="" vertex="1">
                    <mxGeometry height="140" width="340" x="280" y="1461" as="geometry">
                        <mxRectangle height="30" width="110" x="244" y="720" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="212" parent="211" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="1.&amp;nbsp;" vertex="1">
                    <mxGeometry height="50" width="340" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="216" parent="211" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(204, 0, 0));&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Install package globally and then add that same package in any local repo and then notice the downloaded files status and do vice-versa too&lt;/font&gt;&lt;/span&gt;" vertex="1">
                    <mxGeometry height="60" width="340" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="26" edge="1" parent="1" source="21" style="edgeStyle=none;html=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;flowAnimation=1;" target="33">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1010" y="-260" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="21" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;gradientColor=#97d077;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b style=&quot;&quot;&gt;Package files Storing Architecture&lt;/b&gt;&lt;/font&gt;" vertex="1">
                    <mxGeometry height="450" width="390" x="675" y="-290" as="geometry">
                        <mxRectangle height="30" width="110" x="655" y="-230" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="22" parent="21" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="1.&amp;nbsp;pnpm uses a content-addressable store. Files are stored according to a hash of their contents&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;The hash is alway calcuated for the files in a package while adding in store, now even if two package have same content, their hash will always be same&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="100" width="390" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="198" parent="21" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;div&gt;FIles are stores in&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;hash-based sharding/fan-out architecture: -&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;ol style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30);&quot;&gt;&lt;li style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30);&quot;&gt;&lt;font style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30); color: light-dark(rgb(192, 192, 192), rgb(255, 255, 255));&quot;&gt;const hash&amp;nbsp; &amp;nbsp; = &quot;00cc06fe80fe136b07a2bcc082944...&quot;;&amp;nbsp; // j&lt;u style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30);&quot;&gt;ust computed from file bytes of a file&lt;/u&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30);&quot;&gt;&lt;font style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30); color: light-dark(rgb(192, 192, 192), rgb(255, 255, 255));&quot;&gt;const dirName = hash.slice(0, 2);&amp;nbsp; &amp;nbsp;// &quot;00&quot;&amp;nbsp; &amp;lt;- &lt;u style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30);&quot;&gt;This file will go in this directory&lt;/u&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30);&quot;&gt;&lt;font style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30); color: light-dark(rgb(192, 192, 192), rgb(255, 255, 255));&quot;&gt;const fileName = hash.slice(2);&amp;nbsp; &amp;nbsp; &amp;nbsp;// &lt;u style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30);&quot;&gt;rest of hash will be the name of that file&lt;/u&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30);&quot;&gt;&lt;font style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30); color: light-dark(rgb(192, 192, 192), rgb(255, 255, 255));&quot;&gt;const fullPath = `store/v11/files/00/cc06fe80fe136b07a2bcc082944...`; // And it will be stored like this, So the &lt;span style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30); background-color: light-dark(rgb(255, 255, 255), rgb(102, 102, 0));&quot;&gt;full file hash is calculated as dir Hash + file Hash&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
                    <mxGeometry height="200" width="390" y="130" as="geometry"/>
                </mxCell>
                <mxCell id="199" parent="21" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="This way filesystem is optimized, else it would make filesystem lookups slower" vertex="1">
                    <mxGeometry height="60" width="390" y="330" as="geometry"/>
                </mxCell>
                <mxCell id="143" parent="21" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(204, 0, 0));&quot;&gt;View the pnpm store path, and then open that path in explorer and see how the files of packages are organized in the pnpm store folder&lt;/span&gt;" vertex="1">
                    <mxGeometry height="60" width="390" y="390" as="geometry"/>
                </mxCell>
                <mxCell id="76" edge="1" parent="1" source="33" style="edgeStyle=none;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;flowAnimation=1;" target="27">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="33" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#ffcccc;strokeColor=#36393d;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b style=&quot;&quot;&gt;pnpm package creating/building from hash files&lt;/b&gt;&lt;/font&gt;" vertex="1">
                    <mxGeometry height="130" width="360" x="1040" y="-490" as="geometry">
                        <mxRectangle height="30" width="110" x="975" y="-440" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="34" parent="33" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;ol&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;pnpm doesn&#39;t figure out what to hard-link by scanning the &lt;code data-end=&quot;178&quot; data-start=&quot;170&quot;&gt;files/&lt;/code&gt; directory. It already knows exactly which files belong to the package because that information is stored in the package index (the metadata you saw in &lt;code data-end=&quot;340&quot; data-start=&quot;330&quot;&gt;index.db&lt;/code&gt;).&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
                    <mxGeometry height="100" width="360" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="245" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#ffcccc;strokeColor=#36393d;" value="&lt;b&gt;More about pnpm dlx&lt;/b&gt;" vertex="1">
                    <mxGeometry height="541" width="360" x="1380" y="270" as="geometry">
                        <mxRectangle height="30" width="110" x="975" y="-440" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="171" parent="245" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;rounded=0;dashed=1;dashPattern=1 4;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1. pnpm dlx: -&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;When we dont want to install the package permanently, and using it temporarily&lt;/span&gt;&lt;div&gt;&lt;span&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1. pnpm alway check for dlx packages, in its ~/.cache/pnpm/dlx, &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 0, 204));&quot;&gt;with hash name calcuate using the pnx command content&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;,&lt;/font&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt; &lt;/font&gt;&lt;font style=&quot;background-color: rgb(153, 0, 153); color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0));&quot;&gt;if it does not exist then&lt;/font&gt;&lt;/font&gt;&lt;/span&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;Downloads the package in virtual directory, inside a folder named as package name&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;ol&gt;&lt;li&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(192, 192, 192);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(192, 192, 192), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;All&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 0, 51));&quot;&gt;the versions of that package will be downloaded in this folder&lt;/span&gt; with each package &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 76, 153));&quot;&gt;folder named as package version&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;font style=&quot;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2. Now pnpm will create hardlinked -&amp;gt; symlinked folders for that package in it cache folder &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 0, 51));&quot;&gt;named as the hash computed of the pnpmx cmd content&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;pnpm does this so that it know the dlx package is also being referenced somewhere&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ol&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;3. Bydefualt&amp;nbsp; dlx packags expiry time is indefinite, if expiry is not configed in config file&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;4. Pnpm calculates the remaining expiry time of these dlx package by comparing cache hash folder creation time(file system timestamp) with the max-expiry-set in the config file&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="361" width="360" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="195" parent="245" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: light-dark(rgb(255, 255, 255), rgb(204, 0, 0));&quot;&gt;install multiple dlx pacakge , install different versions of same packages then notice the virturl dir,&amp;nbsp; and then delete one hte hash folder from the cache, then run prune cmd and again inspect the virtual dir for that specific package folder&lt;/font&gt;" vertex="1">
                    <mxGeometry height="100" width="360" y="391" as="geometry"/>
                </mxCell>
                <mxCell id="142" parent="245" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(204, 0, 0));&quot;&gt;&amp;nbsp;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(192, 192, 192), rgb(255, 255, 255));&quot;&gt;view the pnpm dlx cache folder (~/cache/pnpm/dlx)&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;" vertex="1">
                    <mxGeometry height="50" width="360" y="491" as="geometry"/>
                </mxCell>
                <mxCell id="39" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#ffcccc;strokeColor=#36393d;" value="&lt;b&gt;Re-installing newer version of the same package&lt;/b&gt;" vertex="1">
                    <mxGeometry height="250" width="440" x="-400" y="40" as="geometry">
                        <mxRectangle height="30" width="110" x="350" y="160" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="41" parent="39" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="Suppose now we are installing a newer version of the same package, which has&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 51, 102));&quot;&gt; 80% of the same code files&lt;/span&gt;" vertex="1">
                    <mxGeometry height="60" width="440" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="85" parent="39" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;ol&gt;&lt;li&gt;Pnpm fetches hte new version&#39;s metadata/tarball and verifies integrity&lt;/li&gt;&lt;li&gt;For each file in that tarball, it ocmputes the content hash&lt;/li&gt;&lt;li&gt;checks: does the file wiith this exact hash already exist in the store,&amp;nbsp;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 51, 102));&quot;&gt;if yes, then it skip writing it,&lt;/span&gt; just reusee the existing stored file (hardlink it into node_module/.pnpm when needed)&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 51, 102));&quot;&gt;if No, then it write this new file into the store&lt;/span&gt; under its calculated new hash&lt;/li&gt;&lt;/ol&gt;" vertex="1">
                    <mxGeometry height="160" width="440" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="250" edge="1" parent="1" source="95" style="edgeStyle=none;html=1;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" target="249">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1320" y="530" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="95" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#ffcccc;strokeColor=#36393d;" value="&lt;b&gt;different pnpm cmds&amp;nbsp;&lt;/b&gt;" vertex="1">
                    <mxGeometry height="430" width="460" x="675" y="270" as="geometry">
                        <mxRectangle height="30" width="110" x="675" y="270" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="96" parent="95" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1. pnpm dlx: -&amp;nbsp; alias cmds&amp;nbsp;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 76, 153));&quot;&gt;pnx, pnpx&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;span&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;When we dont want to install the package permanently, and using it temporarily&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;For more detail see the diagram towards the right -&amp;gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="80" width="460" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="122" parent="95" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="1. pnpm exec: - If we want to directly execute the cli file from current project node_modules/.bin" vertex="1">
                    <mxGeometry height="60" width="460" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="119" parent="95" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2. Check and remove orphaned/unreferenced/unlinked packages in the store&lt;/font&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;On pnpm remove, it will only delink, the package from the current project, and wont delete the package from the store&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;So claim the disk space, we will have to explicitly run the prune cmd, &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 76, 153));&quot;&gt;it will delete all the packages that is not refrenced by any project and the dlx packages that has expired&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="460" y="170" as="geometry"/>
                </mxCell>
                <mxCell id="123" parent="95" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="3. We can also link any version of any package, already avaliable in our store, using &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(153, 0, 153));&quot;&gt;--offline cmd&lt;/span&gt;, without even a single network fetch" vertex="1">
                    <mxGeometry height="60" width="460" y="320" as="geometry"/>
                </mxCell>
                <mxCell id="172" parent="95" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;4. we can&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 0, 204));&quot;&gt; directly add the package in the store itself, &lt;/span&gt;&lt;span&gt;but it will be an orphan/unreferenced package, so prune cmd will delete these packages too&lt;/span&gt;&lt;/font&gt;" vertex="1">
                    <mxGeometry height="50" width="460" y="380" as="geometry"/>
                </mxCell>
                <mxCell id="205" edge="1" parent="1" source="130" style="edgeStyle=none;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;flowAnimation=1;" target="200">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="-390" y="468.47058823529414" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="130" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#cce5ff;strokeColor=#36393d;" value="&lt;b&gt;Pnpm setup/configuration&lt;/b&gt;" vertex="1">
                    <mxGeometry height="310" width="380" x="-200" y="454" as="geometry">
                        <mxRectangle height="30" width="110" x="-200" y="454" as="alternateBounds"/>
                    </mxGeometry>
