                    </mxGeometry>
                </mxCell>
                <mxCell id="247" value="packages with install/postinstall scripts (native binary builds, like &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;sharp&lt;/code&gt; which compiles/downloads image processing binaries, or &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;unrs-resolver&lt;/code&gt; which has a native Rust resolver binary) are &lt;strong&gt;blocked from running their build scripts by default&lt;/strong&gt;. This is a supply-chain security measure — a malicious package could otherwise run arbitrary code at install time via &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;postinstall&lt;/code&gt;." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-420" y="-130" width="400" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="248" value="&lt;span style=&quot;color: rgb(180, 180, 180); font-family: Poppins, &amp;quot;Noto Color Emoji&amp;quot;, sans-serif; font-size: 14px; text-align: start; white-space: pre-wrap; background-color: rgb(18, 18, 18);&quot;&gt;in npm we need need shell for two diffrent things 1. shell npm uses to run scripts written in package.json: -&amp;gt; npm config get shell &amp;lt;- which be seen by this cmd and second one is 2.  shell used to run npm scripts those are inside the node_modules/.bin folder -&amp;gt; npm config get script-shell &amp;lt;- which can be seen by this cmd&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-310" y="-980" width="440" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="261" value="Package is main file for installing the exact verion of the packages in produciton&lt;br&gt;&lt;br&gt;while the semver ranges version in packageJson is only for hte dev&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The real distinction is &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;npm install&lt;/code&gt; vs &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;npm install --frozen-lockfile&lt;/code&gt;, not dev vs. production:&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
                    <mxGeometry x="-420" y="40" width="390" height="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>