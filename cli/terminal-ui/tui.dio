                <mxCell id="MOgwgX5Pt7KfMnz4-GkR-57" parent="MOgwgX5Pt7KfMnz4-GkR-9" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;fontColor=light-dark(#FFFFFF,#FFFFFF);" value="&lt;ol&gt;&lt;li&gt;Shell creates a kernel pipe.&lt;/li&gt;&lt;li&gt;programs&amp;nbsp; stdout points to the pipe&#39;s write end&lt;/li&gt;&lt;li&gt;Program&amp;nbsp;stdin points to the pipe&#39;s read end.&lt;/li&gt;&lt;li&gt;program&amp;nbsp;stdout normally still points to the PTY&lt;/li&gt;&lt;/ol&gt;" vertex="1">
                    <mxGeometry height="130" width="390" y="90" as="geometry"/>
                </mxCell>
