                <mxCell id="SO165_4_2_Le_3jqUpjJ-46" edge="1" parent="1" source="SO165_4_2_Le_3jqUpjJ-14" style="html=1;exitX=0.99;exitY=0.114;exitDx=0;exitDy=0;entryX=-0.003;entryY=0.116;entryDx=0;entryDy=0;entryPerimeter=0;exitPerimeter=0;" target="SO165_4_2_Le_3jqUpjJ-17">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1230" y="1705" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-14" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;roundedPerimeter=1;" value="Font/text Shaping&amp;nbsp;" vertex="1">
                    <mxGeometry height="180" width="287.5" x="650" y="1495" as="geometry">
                        <mxRectangle height="30" width="140" x="20.5" y="1215" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-16" parent="SO165_4_2_Le_3jqUpjJ-14" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;strong&gt;Cell size&lt;/strong&gt; comes from the font: the width of one monospace advance and the line height" vertex="1">
                    <mxGeometry height="50" width="287.5" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-44" parent="SO165_4_2_Le_3jqUpjJ-14" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;strong&gt;Font lookup&lt;/strong&gt;: find a font with a glyph for the code point, using fallback fonts if the primary one lacks it. This is where boxes and &lt;code dir=&quot;ltr&quot;&gt;�&lt;/code&gt; come from." vertex="1">
                    <mxGeometry height="50" width="287.5" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-45" parent="SO165_4_2_Le_3jqUpjJ-14" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;strong&gt;Shaping&lt;/strong&gt; (optional, for ligatures and complex scripts like Devanagari) using something like HarfBuzz." vertex="1">
                    <mxGeometry height="50" width="287.5" y="130" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-37" edge="1" parent="1" source="SO165_4_2_Le_3jqUpjJ-17" style="edgeStyle=none;html=1;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="SO165_4_2_Le_3jqUpjJ-33">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1260" y="1775" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-17" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;roundedPerimeter=1;fontColor=light-dark(#FFFFFF,#FFFFFF);" value="Rasterization" vertex="1">
                    <mxGeometry height="110" width="320" x="1130" y="1505" as="geometry">
                        <mxRectangle height="30" width="110" x="510" y="950" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-18" parent="SO165_4_2_Le_3jqUpjJ-17" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="Draws cell backgrounds, glyphs, cursor and decorations" vertex="1">
                    <mxGeometry height="40" width="320" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-47" parent="SO165_4_2_Le_3jqUpjJ-17" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;strong&gt;Glyph rasterization&lt;/strong&gt; into a bitmap using FreeType, CoreText, or DirectWrite." vertex="1">
                    <mxGeometry height="40" width="320" y="70" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-52" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;roundedPerimeter=1;fontColor=#ffffff;fillColor=#d80073;strokeColor=#A50040;" value="Giberish" vertex="1">
                    <mxGeometry height="280" width="460" x="1110" y="2295" as="geometry">
                        <mxRectangle height="30" width="110" x="510" y="950" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-53" parent="SO165_4_2_Le_3jqUpjJ-52" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="Gibberish can come from steps 1 (wrong decoding), 2 (binary data parsed as escape codes), or 4 (no glyph in the font)" vertex="1">
                    <mxGeometry height="40" width="460" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-55" parent="SO165_4_2_Le_3jqUpjJ-52" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="1.&amp;nbsp;&lt;b&gt;Encoding Mismatch:&lt;/b&gt; If the byte stream coming into Step 2 is Windows-1252 but the terminal&#39;s parser expects UTF-8, the byte boundaries get scrambled before they ever hit the grid." vertex="1">
                    <mxGeometry height="70" width="460" y="70" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-56" parent="SO165_4_2_Le_3jqUpjJ-52" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="2. the font engine for a character code point that doesn&#39;t exist in your font file, the font engine returns a blank or a fallback &quot;tofu&quot; block because no texture exists for it in the glyph atlas" vertex="1">
                    <mxGeometry height="70" width="460" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-57" parent="SO165_4_2_Le_3jqUpjJ-52" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="3. interpreting binary data as ANSI escape codes, scrambling the terminal state and corrupting the grid coordinates." vertex="1">
                    <mxGeometry height="70" width="460" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-73" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;roundedPerimeter=1;fontColor=#ffffff;fillColor=#647687;strokeColor=#314354;" value="More to do" vertex="1">
                    <mxGeometry height="140" width="460" x="1680" y="2325" as="geometry">
                        <mxRectangle height="30" width="110" x="510" y="950" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-74" parent="SO165_4_2_Le_3jqUpjJ-73" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="Programs talk to the terminal through the kernel’s tty API: &lt;code dir=&quot;ltr&quot;&gt;termios&lt;/code&gt; (&lt;code dir=&quot;ltr&quot;&gt;tcgetattr&lt;/code&gt;/&lt;code dir=&quot;ltr&quot;&gt;tcsetattr&lt;/code&gt;) and &lt;code dir=&quot;ltr&quot;&gt;ioctl&lt;/code&gt;. Those calls only succeed on a real tty file descriptor. So the terminal emulator can’t just hand over a pipe and implement the behavior itself, because &lt;code dir=&quot;ltr&quot;&gt;isatty()&lt;/code&gt; would be false and &lt;code dir=&quot;ltr&quot;&gt;tcsetattr&lt;/code&gt; would fail." vertex="1">
                    <mxGeometry height="110" width="460" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-24" edge="1" parent="1" source="SO165_4_2_Le_3jqUpjJ-22" style="edgeStyle=none;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="SO165_4_2_Le_3jqUpjJ-23">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;p dir=&quot;ltr&quot;&gt;Every cell in this grid holds a data structure containing:&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;The Unicode code point of the character.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;Style attributes (foreground color, background color, underline, bold, italic).&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
                    <mxGeometry height="170" width="400" x="1280" y="1045" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="When text is printed, the terminal writes characters into this grid at the current cursor position and advances the cursor. If text hits the edge of the screen, the grid either wraps or scrolls up.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;like: - cursor position, current “pen” style, scroll region, tab stops, the &lt;strong&gt;scrollback&lt;/strong&gt; buffer, and the &lt;strong&gt;alternate screen&lt;/strong&gt; (what vim and less switch to, so your shell history comes back when you quit).&lt;/div&gt;" vertex="1">
                    <mxGeometry height="135" width="372" x="1840" y="1100" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-26" edge="1" parent="1" source="SO165_4_2_Le_3jqUpjJ-25" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="SO165_4_2_Le_3jqUpjJ-14">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1111.25" y="1415" as="sourcePoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-25" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;" value="&amp;nbsp;the terminal&#39;s rendering engine&lt;div&gt;work&lt;/div&gt;" vertex="1">
                    <mxGeometry height="100" width="150" x="903.75" y="1250" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="It takes the Unicode code point (e.g., &lt;code&gt;U+0041&lt;/code&gt; for &#39;A&#39;).&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;It queries the operating system&#39;s font shaping engine (like &lt;b&gt;FreeType&lt;/b&gt; on Linux, &lt;b&gt;CoreText&lt;/b&gt; on macOS, or &lt;b&gt;DirectWrite&lt;/b&gt; on Windows) and requests the vector outline for that character from your active terminal font.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="150" width="375" x="1100" y="1750" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;b&gt;The Optimization (Glyph Atlases):&lt;/b&gt; Rendering vector outlines for every single character on every frame would destroy CPU performance. Instead, terminals use a &lt;b&gt;glyph cache&lt;/b&gt;. Frequently used characters are rendered once into a texture atlas (a GPU memory sheet), and the terminal treats them as pre-rendered bitmap textures" vertex="1">
                    <mxGeometry height="110" width="375" x="1117.5" y="1975" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-51" edge="1" parent="1" source="SO165_4_2_Le_3jqUpjJ-33" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="SO165_4_2_Le_3jqUpjJ-50">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Modern GPU-accelerated terminals (like Alacritty, Kitty, WezTerm, or Windows Terminal) bypass traditional CPU drawing and hand the grid directly to the graphics card:" vertex="1">
                    <mxGeometry height="70" width="320" x="1650" y="1495" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;h4 dir=&quot;ltr&quot; aria-level=&quot;5&quot;&gt;&amp;nbsp;Decoding&lt;/h4&gt;&lt;p dir=&quot;ltr&quot;&gt;The incoming bytes are decoded as UTF-8 into code points. This is where mismatched encodings produce gibberish, as in the first question.&lt;/p&gt;" vertex="1">
                    <mxGeometry height="120" width="300" x="1160" y="770" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;h4 dir=&quot;ltr&quot; aria-level=&quot;5&quot;&gt;&amp;nbsp;Parsing the stream&lt;/h4&gt;&lt;p dir=&quot;ltr&quot;&gt;The bytes mix printable text and &lt;strong&gt;control codes&lt;/strong&gt;, which are instructions rather than text:&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;C0 controls&lt;/strong&gt;: &lt;code dir=&quot;ltr&quot;&gt;\n&lt;/code&gt; (move down), &lt;code dir=&quot;ltr&quot;&gt;\r&lt;/code&gt; (cursor to column 0), &lt;code dir=&quot;ltr&quot;&gt;\b&lt;/code&gt; (back one), &lt;code dir=&quot;ltr&quot;&gt;\t&lt;/code&gt; (tab), &lt;code dir=&quot;ltr&quot;&gt;\a&lt;/code&gt; (bell)&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;Escape sequences&lt;/strong&gt; starting with &lt;code dir=&quot;ltr&quot;&gt;ESC&lt;/code&gt; (&lt;code dir=&quot;ltr&quot;&gt;0x1B&lt;/code&gt;):&lt;br&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;CSI&lt;/strong&gt; &lt;code dir=&quot;ltr&quot;&gt;ESC [ ...&lt;/code&gt; such as &lt;code dir=&quot;ltr&quot;&gt;ESC[31m&lt;/code&gt; (red text), &lt;code dir=&quot;ltr&quot;&gt;ESC[2;5H&lt;/code&gt; (move cursor to row 2, col 5), &lt;code dir=&quot;ltr&quot;&gt;ESC[2J&lt;/code&gt; (clear screen)&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;OSC&lt;/strong&gt; &lt;code dir=&quot;ltr&quot;&gt;ESC ] ...&lt;/code&gt; such as setting the window title or making hyperlinks&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;DCS&lt;/strong&gt; and others for things like Sixel images&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
                    <mxGeometry height="320" width="740" x="-100" y="895" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-50" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&amp;nbsp;modern GPU terminals (Alacritty, Kitty, WezTerm, Ghostty) cache rasterized glyphs in a &lt;strong&gt;texture atlas&lt;/strong&gt; and draw one textured quad per cell with OpenGL, Metal, or Vulkan.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Older ones like xterm draw with CPU-side calls&lt;/div&gt;" vertex="1">
                    <mxGeometry height="100" width="372" x="1650" y="1635" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-72" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value=". A PTY isn’t needed to talk to a shell, it’s needed to make the shell and the programs it runs &lt;strong&gt;behave interactively&lt;/strong&gt;&lt;div&gt;&lt;strong&gt;&lt;br&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;color: rgb(112, 184, 255);&quot;&gt;echo&lt;/span&gt; &lt;span style=&quot;color: rgb(155, 233, 99);&quot;&gt;&quot;ls -l&quot;&lt;/span&gt; | &lt;span style=&quot;color: rgb(112, 184, 255);&quot;&gt;bash // no pty required&lt;/span&gt;&lt;/span&gt;&lt;strong&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;color: rgb(112, 184, 255);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;So the PTY is a compatibility layer. It exists so a program written for a 1970s serial terminal still works unchanged when the “terminal” is a window on your screen.&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;color: rgb(112, 184, 255);&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="140" width="410" x="1450" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-79" edge="1" parent="1" source="SO165_4_2_Le_3jqUpjJ-78" style="edgeStyle=none;html=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" target="SO165_4_2_Le_3jqUpjJ-81">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="2020" y="-810" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-93" connectable="0" parent="SO165_4_2_Le_3jqUpjJ-79" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];inheritText=1;" value="Produce text and control sequence" vertex="1">
                    <mxGeometry relative="1" x="-0.0525" y="2" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="1UfuDj-I-o0t-QmothvO-10" edge="1" parent="1" source="SO165_4_2_Le_3jqUpjJ-78" style="edgeStyle=none;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="SO165_4_2_Le_3jqUpjJ-89">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
