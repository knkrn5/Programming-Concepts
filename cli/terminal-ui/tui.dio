                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-18" parent="SO165_4_2_Le_3jqUpjJ-17" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;fontColor=light-dark(#FFFFFF,#FFFFFF);" value="&lt;b&gt;Vector Rasterization:&lt;/b&gt; &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(204, 102, 0));&quot;&gt;Converting mathematical curves/outline (Bezier curves) into a grid of pixels&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(153, 153, 0));&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(51, 51, 0));&quot;&gt;into of&amp;nbsp;Bitmap or coverage mask&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;potentially using hinting and anti-aliasing.&lt;/span&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt;&lt;b style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20);&quot;&gt;shaping engine&lt;/b&gt;&lt;span style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;&lt;b style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20);&quot;&gt; &lt;/b&gt;(like &lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;&lt;b style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt;FreeType&lt;/b&gt;&lt;span style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt; on Linux, &lt;/span&gt;&lt;b style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt;CoreText&lt;/b&gt;&lt;span style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt; on macOS, or &lt;/span&gt;&lt;b style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt;DirectWrite&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt; on Windows)&lt;/span&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(204, 102, 0));&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="100" width="430" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="MOgwgX5Pt7KfMnz4-GkR-24" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;roundedPerimeter=1;fillColor=light-dark(#CDEB8B,#663300);strokeColor=#36393d;" value="&lt;b&gt;OPtimization and extra&lt;/b&gt;" vertex="1">
                    <mxGeometry height="200" width="620" x="150" y="2690" as="geometry">
                        <mxRectangle height="30" width="110" x="510" y="950" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="MOgwgX5Pt7KfMnz4-GkR-25" parent="MOgwgX5Pt7KfMnz4-GkR-24" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;fontColor=light-dark(#FFFFFF,#FFFFFF);" value="&lt;span style=&quot;text-align: center;&quot;&gt;Modern GPU-accelerated terminals (like Alacritty, Kitty, WezTerm, or Windows Terminal) bypass traditional CPU drawing and hand the grid directly to the graphics card:&lt;/span&gt;" vertex="1">
                    <mxGeometry height="70" width="620" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="MOgwgX5Pt7KfMnz4-GkR-29" parent="MOgwgX5Pt7KfMnz4-GkR-24" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;fontColor=light-dark(#C0C0C0,#FFFFFF);" value="&lt;b style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt;The Optimization (Glyph Atlases):&lt;/b&gt;&lt;span style=&quot;text-align: center;&quot;&gt; Rendering vector outlines for every single character on every frame would destroy CPU performance. Instead, &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;mordern terminals use a &lt;/span&gt;&lt;/span&gt;&lt;b style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center; background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;glyph cache&lt;/b&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;.&lt;/span&gt; &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;Frequently used characters are rendered once into a texture atlas &lt;/span&gt;(a GPU memory sheet), and the terminal treats them as pre-rendered bitmap textures&lt;/span&gt;" vertex="1">
                    <mxGeometry height="100" width="620" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="1UfuDj-I-o0t-QmothvO-49" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;roundedPerimeter=1;fillColor=light-dark(#CDEB8B,#663300);strokeColor=#36393d;" value="&lt;strong&gt;Rendering engine&lt;/strong&gt;" vertex="1">
                    <mxGeometry height="70" width="430" x="860" y="2210" as="geometry">
                        <mxRectangle height="30" width="110" x="802" y="2050" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="1UfuDj-I-o0t-QmothvO-50" parent="1UfuDj-I-o0t-QmothvO-49" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="Composites rasterized glyphs with backgrounds, colors, other graphics and UI layers." vertex="1">
                    <mxGeometry height="40" width="430" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-52" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;roundedPerimeter=1;fontColor=#ffffff;fillColor=#d80073;strokeColor=#A50040;" value="Giberish" vertex="1">
                    <mxGeometry height="280" width="460" x="80" y="3080" as="geometry">
                        <mxRectangle height="30" width="110" x="510" y="950" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-53" parent="SO165_4_2_Le_3jqUpjJ-52" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="Gibberish can come from steps 1 (wrong decoding), 2 (binary data parsed as escape codes), or 4 (no glyph in the font)" vertex="1">
                    <mxGeometry height="40" width="460" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-55" parent="SO165_4_2_Le_3jqUpjJ-52" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="1.&amp;nbsp;&lt;b&gt;Encoding Mismatch:&lt;/b&gt; If the byte stream coming into Step 2 is Windows-1252 but the terminal&#39;s parser expects UTF-8, the byte boundaries get scrambled before they ever hit the grid." vertex="1">
                    <mxGeometry height="70" width="460" y="70" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-56" parent="SO165_4_2_Le_3jqUpjJ-52" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="2. the font engine for a character code point that doesn&#39;t exist in your font file, the font engine returns a blank or a fallback &quot;tofu&quot; block because no texture exists for it in the glyph atlas" vertex="1">
                    <mxGeometry height="70" width="460" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-57" parent="SO165_4_2_Le_3jqUpjJ-52" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="3. interpreting binary data as ANSI escape codes, scrambling the terminal state and corrupting the grid coordinates." vertex="1">
                    <mxGeometry height="70" width="460" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-73" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;roundedPerimeter=1;fontColor=#ffffff;fillColor=#647687;strokeColor=#314354;" value="More to do" vertex="1">
                    <mxGeometry height="140" width="460" x="650" y="3110" as="geometry">
                        <mxRectangle height="30" width="110" x="510" y="950" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-74" parent="SO165_4_2_Le_3jqUpjJ-73" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="Programs talk to the terminal through the kernel’s tty API: &lt;code dir=&quot;ltr&quot;&gt;termios&lt;/code&gt; (&lt;code dir=&quot;ltr&quot;&gt;tcgetattr&lt;/code&gt;/&lt;code dir=&quot;ltr&quot;&gt;tcsetattr&lt;/code&gt;) and &lt;code dir=&quot;ltr&quot;&gt;ioctl&lt;/code&gt;. Those calls only succeed on a real tty file descriptor. So the terminal emulator can’t just hand over a pipe and implement the behavior itself, because &lt;code dir=&quot;ltr&quot;&gt;isatty()&lt;/code&gt; would be false and &lt;code dir=&quot;ltr&quot;&gt;tcsetattr&lt;/code&gt; would fail." vertex="1">
                    <mxGeometry height="110" width="460" y="30" as="geometry"/>
                </mxCell>
