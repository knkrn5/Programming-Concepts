                <mxCell id="1UfuDj-I-o0t-QmothvO-47" parent="SO165_4_2_Le_3jqUpjJ-14" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;strong&gt;Cell size&lt;/strong&gt; comes from the font: the width of one monospace advance and the line height" vertex="1">
                    <mxGeometry height="50" width="550" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-44" parent="SO165_4_2_Le_3jqUpjJ-14" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;fontColor=light-dark(#C0C0C0,#FFFFFF);" value="&lt;strong style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;Font lookup&lt;/strong&gt;: find a font with a glyph for the Unicode code point, using fallback fonts if the primary one lacks it. This is where boxes and &lt;code dir=&quot;ltr&quot;&gt;�&lt;/code&gt; come from.&lt;div&gt;&lt;font color=&quot;#ffffff&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;text-align: center;&quot;&gt;It queries the operating system&#39;s font &lt;b&gt;shaping engine&lt;/b&gt;&lt;b style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt; &lt;/b&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;(&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;HarfBuzz / DirectWrite&lt;/span&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;)&lt;/span&gt; and requests the vector outline for that character from your active terminal font.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="100" width="550" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-16" parent="SO165_4_2_Le_3jqUpjJ-14" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="It calculates the mathematical vector ouline/shape required" vertex="1">
