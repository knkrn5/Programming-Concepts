                    <mxGeometry height="80" width="80" x="2070" y="-920" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-82" edge="1" parent="1" source="SO165_4_2_Le_3jqUpjJ-80" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="2310" y="-560" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-86" connectable="0" parent="SO165_4_2_Le_3jqUpjJ-82" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];inheritText=1;" value="how bytes&lt;div&gt;are send&lt;/div&gt;" vertex="1">
                    <mxGeometry relative="1" x="0.0423" y="1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-80" parent="1" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;" value="potocol" vertex="1">
                    <mxGeometry height="80" width="80" x="2200" y="-860" as="geometry"/>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-84" edge="1" parent="1" source="SO165_4_2_Le_3jqUpjJ-81" style="edgeStyle=none;html=1;exitX=0.225;exitY=0.95;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" target="1UfuDj-I-o0t-QmothvO-1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1920" y="-650" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-85" connectable="0" parent="SO165_4_2_Le_3jqUpjJ-84" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];inheritText=1;" value="stream" vertex="1">
                    <mxGeometry relative="1" x="0.0943" y="-1" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="SO165_4_2_Le_3jqUpjJ-95" edge="1" parent="1" source="SO165_4_2_Le_3jqUpjJ-81" style="edgeStyle=none;html=1;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" target="SO165_4_2_Le_3jqUpjJ-78">
