                    <mxGeometry height="260" width="492" x="172" y="1390" as="geometry">
                        <mxRectangle height="30" width="110" x="260" y="630" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-56" parent="oYyQDbu6_vZpWYy5zJs6-55" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;fontColor=light-dark(#FFFFFF,#FFFFFF);" value="&lt;div&gt;In&amp;nbsp;&lt;span style=&quot;text-align: center; background-color: transparent;&quot;&gt;&amp;nbsp;one terminal, all cells are the same size.&lt;/span&gt;&lt;/div&gt;a&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 102, 0));&quot;&gt; terminal maintains a rigid &lt;b&gt;2D character grid&lt;/b&gt; &lt;/span&gt;in memory" vertex="1">
                    <mxGeometry height="45" width="492" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-57" parent="oYyQDbu6_vZpWYy5zJs6-55" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;fontColor=light-dark(#FFFFFF,#FFFFFF);" value="&lt;span style=&quot;text-align: center;&quot;&gt;Once the bytes are decoded, now Every cell in this&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 102, 51));&quot;&gt; grid holds a data structure containing&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 102, 51));&quot;&gt;&amp;nbsp;&lt;/span&gt;:&amp;nbsp; -&lt;div&gt;&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&amp;nbsp;Unicode code point of the character.&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20);&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20);&quot;&gt;Style attributes (foreground color, background color, underline, bold, italic). in &lt;b&gt;ASNI escape sequence chars&lt;/b&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20);&quot;&gt;&lt;p dir=&quot;ltr&quot; style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20);&quot;&gt;other things like cursor position, pen style, window scroll region, tab stops etc&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="185" width="492" y="75" as="geometry"/>
                </mxCell>
