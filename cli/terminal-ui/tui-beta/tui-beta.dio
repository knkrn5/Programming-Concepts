                <mxCell id="oYyQDbu6_vZpWYy5zJs6-52" parent="oYyQDbu6_vZpWYy5zJs6-50" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="The work of the parser is to: -&amp;nbsp;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Imcoming bytes Decoding: - Interprets bytes, Unicode and escape sequences&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
