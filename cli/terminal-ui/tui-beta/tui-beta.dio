                        <mxRectangle height="30" width="140" x="-500" y="2040" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-61" parent="oYyQDbu6_vZpWYy5zJs6-60" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;strong&gt;Cell size&lt;/strong&gt; comes from the font: the width of one monospace advance and the line height" vertex="1">
                    <mxGeometry height="50" width="550" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-62" parent="oYyQDbu6_vZpWYy5zJs6-60" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;fontColor=light-dark(#C0C0C0,#FFFFFF);" value="&lt;strong style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;Font lookup&lt;/strong&gt;: find a font with a glyph for the Unicode code point, using fallback fonts if the primary one lacks it. This is where boxes and &lt;code dir=&quot;ltr&quot;&gt;�&lt;/code&gt; come from.&lt;div&gt;&lt;font color=&quot;#ffffff&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;text-align: center;&quot;&gt;It queries the operating system&#39;s font &lt;b&gt;shaping engine&lt;/b&gt;&lt;b style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt; &lt;/b&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;(&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;HarfBuzz / DirectWrite&lt;/span&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;)&lt;/span&gt; and requests the vector outline for that character from your active terminal font.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="100" width="550" y="80" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-63" parent="oYyQDbu6_vZpWYy5zJs6-60" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="It calculates the mathematical vector ouline/shape required" vertex="1">
                    <mxGeometry height="50" width="550" y="180" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-64" parent="oYyQDbu6_vZpWYy5zJs6-60" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;fontColor=light-dark(#FFFFFF,#FFFFFF);" value="&lt;strong&gt;Shaping&lt;/strong&gt; (optional, for ligatures and complex scripts like Devanagari) using something like HarfBuzz. (&lt;strong style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20);&quot;&gt;Wide characters&lt;/strong&gt;&amp;nbsp;,&amp;nbsp;&lt;strong style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20);&quot;&gt;Combining characters&lt;/strong&gt;)" vertex="1">
                    <mxGeometry height="50" width="550" y="230" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-65" edge="1" parent="1" source="oYyQDbu6_vZpWYy5zJs6-67" style="edgeStyle=none;html=1;exitX=0.995;exitY=0.092;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;exitPerimeter=0;flowAnimation=1;" target="oYyQDbu6_vZpWYy5zJs6-72">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-66" edge="1" parent="1" source="oYyQDbu6_vZpWYy5zJs6-67" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;flowAnimation=1;" target="oYyQDbu6_vZpWYy5zJs6-69">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-67" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;roundedPerimeter=1;fillColor=light-dark(#CDEB8B,#663300);strokeColor=#36393d;" value="&lt;strong&gt;Font rasterizer&lt;/strong&gt;" vertex="1">
                    <mxGeometry height="130" width="430" x="222" y="2220" as="geometry">
                        <mxRectangle height="30" width="110" x="203" y="2060" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-68" parent="oYyQDbu6_vZpWYy5zJs6-67" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;fontColor=light-dark(#FFFFFF,#FFFFFF);" value="&lt;b&gt;Vector Rasterization:&lt;/b&gt; &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(204, 102, 0));&quot;&gt;Converting mathematical curves/outline (Bezier curves) into a grid of pixels&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(153, 153, 0));&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(51, 51, 0));&quot;&gt;into of&amp;nbsp;Bitmap or coverage mask&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;potentially using hinting and anti-aliasing.&lt;/span&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;&lt;span style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt;&lt;b style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20);&quot;&gt;shaping engine&lt;/b&gt;&lt;span style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;&lt;b style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20);&quot;&gt; &lt;/b&gt;(like &lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;&lt;b style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt;FreeType&lt;/b&gt;&lt;span style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt; on Linux, &lt;/span&gt;&lt;b style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt;CoreText&lt;/b&gt;&lt;span style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt; on macOS, or &lt;/span&gt;&lt;b style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt;DirectWrite&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt;&lt;span style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt; on Windows)&lt;/span&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(204, 102, 0));&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="100" width="430" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-69" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;roundedPerimeter=1;fillColor=light-dark(#CDEB8B,#663300);strokeColor=#36393d;" value="&lt;b&gt;OPtimization and extra&lt;/b&gt;" vertex="1">
                    <mxGeometry height="200" width="620" x="150" y="2690" as="geometry">
                        <mxRectangle height="30" width="110" x="510" y="950" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-70" parent="oYyQDbu6_vZpWYy5zJs6-69" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;fontColor=light-dark(#FFFFFF,#FFFFFF);" value="&lt;span style=&quot;text-align: center;&quot;&gt;Modern GPU-accelerated terminals (like Alacritty, Kitty, WezTerm, or Windows Terminal) bypass traditional CPU drawing and hand the grid directly to the graphics card:&lt;/span&gt;" vertex="1">
                    <mxGeometry height="70" width="620" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-71" parent="oYyQDbu6_vZpWYy5zJs6-69" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;fontColor=light-dark(#C0C0C0,#FFFFFF);" value="&lt;b style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center;&quot;&gt;The Optimization (Glyph Atlases):&lt;/b&gt;&lt;span style=&quot;text-align: center;&quot;&gt; Rendering vector outlines for every single character on every frame would destroy CPU performance. Instead, &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;mordern terminals use a &lt;/span&gt;&lt;/span&gt;&lt;b style=&quot;scrollbar-color: rgba(168, 169, 170, 0.52) rgb(18, 19, 20); text-align: center; background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;glyph cache&lt;/b&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;.&lt;/span&gt; &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(102, 51, 0));&quot;&gt;Frequently used characters are rendered once into a texture atlas &lt;/span&gt;(a GPU memory sheet), and the terminal treats them as pre-rendered bitmap textures&lt;/span&gt;" vertex="1">
                    <mxGeometry height="100" width="620" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-72" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;roundedPerimeter=1;fillColor=light-dark(#CDEB8B,#663300);strokeColor=#36393d;" value="&lt;strong&gt;Rendering engine&lt;/strong&gt;" vertex="1">
                    <mxGeometry height="70" width="430" x="860" y="2210" as="geometry">
                        <mxRectangle height="30" width="110" x="802" y="2050" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-73" parent="oYyQDbu6_vZpWYy5zJs6-72" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="Composites rasterized glyphs with backgrounds, colors, other graphics and UI layers." vertex="1">
                    <mxGeometry height="40" width="430" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-74" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;roundedPerimeter=1;fontColor=#ffffff;fillColor=#d80073;strokeColor=#A50040;" value="Giberish" vertex="1">
                    <mxGeometry height="280" width="460" x="80" y="3080" as="geometry">
                        <mxRectangle height="30" width="110" x="510" y="950" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-75" parent="oYyQDbu6_vZpWYy5zJs6-74" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="Gibberish can come from steps 1 (wrong decoding), 2 (binary data parsed as escape codes), or 4 (no glyph in the font)" vertex="1">
                    <mxGeometry height="40" width="460" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-76" parent="oYyQDbu6_vZpWYy5zJs6-74" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="1.&amp;nbsp;&lt;b&gt;Encoding Mismatch:&lt;/b&gt; If the byte stream coming into Step 2 is Windows-1252 but the terminal&#39;s parser expects UTF-8, the byte boundaries get scrambled before they ever hit the grid." vertex="1">
                    <mxGeometry height="70" width="460" y="70" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-77" parent="oYyQDbu6_vZpWYy5zJs6-74" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="2. the font engine for a character code point that doesn&#39;t exist in your font file, the font engine returns a blank or a fallback &quot;tofu&quot; block because no texture exists for it in the glyph atlas" vertex="1">
                    <mxGeometry height="70" width="460" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-78" parent="oYyQDbu6_vZpWYy5zJs6-74" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="3. interpreting binary data as ANSI escape codes, scrambling the terminal state and corrupting the grid coordinates." vertex="1">
                    <mxGeometry height="70" width="460" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-79" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;roundedPerimeter=1;fontColor=#ffffff;fillColor=#647687;strokeColor=#314354;" value="More to do" vertex="1">
                    <mxGeometry height="140" width="460" x="650" y="3110" as="geometry">
                        <mxRectangle height="30" width="110" x="510" y="950" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-80" parent="oYyQDbu6_vZpWYy5zJs6-79" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="Programs talk to the terminal through the kernel’s tty API: &lt;code dir=&quot;ltr&quot;&gt;termios&lt;/code&gt; (&lt;code dir=&quot;ltr&quot;&gt;tcgetattr&lt;/code&gt;/&lt;code dir=&quot;ltr&quot;&gt;tcsetattr&lt;/code&gt;) and &lt;code dir=&quot;ltr&quot;&gt;ioctl&lt;/code&gt;. Those calls only succeed on a real tty file descriptor. So the terminal emulator can’t just hand over a pipe and implement the behavior itself, because &lt;code dir=&quot;ltr&quot;&gt;isatty()&lt;/code&gt; would be false and &lt;code dir=&quot;ltr&quot;&gt;tcsetattr&lt;/code&gt; would fail." vertex="1">
                    <mxGeometry height="110" width="460" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-81" edge="1" parent="1" source="oYyQDbu6_vZpWYy5zJs6-84" style="edgeStyle=none;html=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="oYyQDbu6_vZpWYy5zJs6-60">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-82" edge="1" parent="1" source="oYyQDbu6_vZpWYy5zJs6-84" style="edgeStyle=none;html=1;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="oYyQDbu6_vZpWYy5zJs6-72">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-83" edge="1" parent="1" source="oYyQDbu6_vZpWYy5zJs6-84" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="oYyQDbu6_vZpWYy5zJs6-67">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-84" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;" value="&amp;nbsp;the terminal&#39;s shaping and rendering engine" vertex="1">
                    <mxGeometry height="100" width="190" x="333" y="1860" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-87" edge="1" parent="1" source="oYyQDbu6_vZpWYy5zJs6-72" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;flowAnimation=1;" target="oYyQDbu6_vZpWYy5zJs6-69">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-88" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;h3 dir=&quot;ltr&quot; aria-level=&quot;4&quot;&gt;Builtins are different&lt;/h3&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;code dir=&quot;ltr&quot;&gt;echo&lt;/code&gt;, &lt;code dir=&quot;ltr&quot;&gt;cd&lt;/code&gt;, &lt;code dir=&quot;ltr&quot;&gt;export&lt;/code&gt;, etc. (usually) don’t &lt;code dir=&quot;ltr&quot;&gt;fork&lt;/code&gt;+&lt;code dir=&quot;ltr&quot;&gt;exec&lt;/code&gt;. The &lt;strong&gt;shell process itself&lt;/strong&gt; runs them, so it writes directly to its own fd 1, which is the PTY. That’s what the line “echo write to the PTY from inside the shell process itself” means. (With &lt;code dir=&quot;ltr&quot;&gt;echo hi &amp;gt; file&lt;/code&gt;, the shell temporarily redirects its own fd 1, runs the builtin, then restores it.)&lt;/p&gt;" vertex="1">
                    <mxGeometry height="155" width="450" x="460" y="-1660" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-89" edge="1" parent="1" source="oYyQDbu6_vZpWYy5zJs6-47" style="edgeStyle=none;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.008;entryY=0.102;entryDx=0;entryDy=0;entryPerimeter=0;flowAnimation=1;" target="oYyQDbu6_vZpWYy5zJs6-6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-90" connectable="0" parent="oYyQDbu6_vZpWYy5zJs6-89" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];inheritText=1;" value="1. hardware input&lt;div&gt;events travels&lt;/div&gt;&lt;div&gt;via process stdin&lt;/div&gt;" vertex="1">
                    <mxGeometry relative="1" x="-0.3109" y="-3" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-91" edge="1" parent="1" source="oYyQDbu6_vZpWYy5zJs6-95" style="edgeStyle=none;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;flowAnimation=1;" target="oYyQDbu6_vZpWYy5zJs6-6">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="398.8840579710145" y="-170" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-92" connectable="0" parent="oYyQDbu6_vZpWYy5zJs6-91" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];inheritText=1;" value="2-a. cmd without&lt;div&gt;pipe/redirect&lt;/div&gt;&lt;div&gt;goes through&lt;/div&gt;&lt;div&gt;PTY&lt;/div&gt;" vertex="1">
                    <mxGeometry relative="1" x="0.1894" y="2" as="geometry">
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-93" edge="1" parent="1" source="oYyQDbu6_vZpWYy5zJs6-95" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;flowAnimation=1;entryX=0.993;entryY=0.08;entryDx=0;entryDy=0;entryPerimeter=0;" target="oYyQDbu6_vZpWYy5zJs6-23">
                    <mxGeometry relative="1" x="-0.7968" as="geometry">
                        <Array as="points">
                            <mxPoint x="1230" y="10"/>
                            <mxPoint x="1230" y="-1297.6"/>
                        </Array>
                        <mxPoint x="690" y="-920" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-94" connectable="0" parent="oYyQDbu6_vZpWYy5zJs6-93" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];inheritText=1;" value="2-c. cmd with&lt;div&gt;pipe/redirect&amp;nbsp;&lt;/div&gt;&lt;div&gt;directly goes&lt;/div&gt;&lt;div&gt;to shell&lt;/div&gt;" vertex="1">
                    <mxGeometry relative="1" x="-0.9242" y="-3" as="geometry">
                        <mxPoint x="50" y="-3" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-95" parent="1" style="rhombus;whiteSpace=wrap;html=1;shapeInside=1;" value="2. Terminal typed text/cmd goes to shell via PTY" vertex="1">
                    <mxGeometry height="100" width="160" x="319" y="-40" as="geometry"/>
                </mxCell>
                <mxCell id="oYyQDbu6_vZpWYy5zJs6-96" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;h3 dir=&quot;ltr&quot; aria-level=&quot;4&quot;&gt;Running &lt;code dir=&quot;ltr&quot;&gt;ls&lt;/code&gt; normally&lt;/h3&gt;&lt;ol dir=&quot;ltr&quot;&gt;&lt;li&gt;Shell calls &lt;code dir=&quot;ltr&quot;&gt;fork()&lt;/code&gt; → creates a child process.&lt;/li&gt;&lt;br&gt;&lt;li&gt;The child &lt;strong&gt;inherits&lt;/strong&gt; fd 0, 1, 2 from the shell, all pointing at the PTY slave.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Child calls &lt;code dir=&quot;ltr&quot;&gt;exec(&quot;ls&quot;)&lt;/code&gt;. The process becomes &lt;code dir=&quot;ltr&quot;&gt;ls&lt;/code&gt;, but keeps its file descriptors.&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;code dir=&quot;ltr&quot;&gt;ls&lt;/code&gt; writes to fd 1 → goes to PTY → appears on your screen.&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;code dir=&quot;ltr&quot;&gt;ls&lt;/code&gt; exits. The shell, which was blocked in &lt;code dir=&quot;ltr&quot;&gt;wait()&lt;/code&gt;, gets the exit code (&lt;code dir=&quot;ltr&quot;&gt;$?&lt;/code&gt;) and prints the next prompt.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
                    <mxGeometry height="267.5" width="500" x="575" y="-1050" as="geometry"/>
                </mxCell>
                <mxCell id="WV5y-KExGOwVp7pzsLpK-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;h3 dir=&quot;ltr&quot; aria-level=&quot;4&quot;&gt;Running &lt;code dir=&quot;ltr&quot;&gt;ls &amp;gt; out.txt&lt;/code&gt;&lt;/h3&gt;&lt;ol dir=&quot;ltr&quot;&gt;&lt;li&gt;Shell calls &lt;code dir=&quot;ltr&quot;&gt;fork()&lt;/code&gt;.&lt;/li&gt;&lt;br&gt;&lt;li&gt;&lt;strong&gt;In the child, before exec&lt;/strong&gt;, the shell opens &lt;code dir=&quot;ltr&quot;&gt;out.txt&lt;/code&gt; and does &lt;code dir=&quot;ltr&quot;&gt;dup2(file_fd, 1)&lt;/code&gt;. Now fd 1 points to the file instead of the PTY.&lt;/li&gt;&lt;br&gt;&lt;li&gt;Child calls &lt;code dir=&quot;ltr&quot;&gt;exec(&quot;ls&quot;)&lt;/code&gt;. &lt;code dir=&quot;ltr&quot;&gt;ls&lt;/code&gt; has no idea anything changed. It writes to fd 1 as usual.&lt;/li&gt;&lt;br&gt;&lt;li&gt;The data goes into &lt;code dir=&quot;ltr&quot;&gt;out.txt&lt;/code&gt;. &lt;strong&gt;Nothing is written to the PTY&lt;/strong&gt;, so you see nothing on screen.&lt;/li&gt;&lt;/ol&gt;&lt;p dir=&quot;ltr&quot;&gt;That’s what “the shell rewires the child’s stdout before exec” means.&lt;/p&gt;" vertex="1">
                    <mxGeometry height="330" width="540" x="-1190" y="-1290" as="geometry"/>
                </mxCell>
                <mxCell id="WV5y-KExGOwVp7pzsLpK-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;h3 dir=&quot;ltr&quot; aria-level=&quot;4&quot;&gt;Running &lt;code dir=&quot;ltr&quot;&gt;ls | grep x&lt;/code&gt;&lt;/h3&gt;&lt;br/&gt;&lt;ol dir=&quot;ltr&quot;&gt;&lt;br/&gt;&lt;li&gt;Shell creates a &lt;strong&gt;pipe&lt;/strong&gt; (a kernel buffer with a read end and a write end).&lt;/li&gt;&lt;br/&gt;&lt;li&gt;Forks two children:&lt;br/&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;br/&gt;&lt;li&gt;&lt;code dir=&quot;ltr&quot;&gt;ls&lt;/code&gt;: fd 1 → write end of pipe&lt;/li&gt;&lt;br/&gt;&lt;li&gt;&lt;code dir=&quot;ltr&quot;&gt;grep&lt;/code&gt;: fd 0 → read end of pipe&lt;/li&gt;&lt;br/&gt;&lt;/ul&gt;&lt;br/&gt;&lt;/li&gt;&lt;br/&gt;&lt;li&gt;&lt;code dir=&quot;ltr&quot;&gt;ls&lt;/code&gt; output flows into the pipe, &lt;code dir=&quot;ltr&quot;&gt;grep&lt;/code&gt; reads it. Only &lt;code dir=&quot;ltr&quot;&gt;grep&lt;/code&gt;’s stdout still points at the PTY, so only the filtered result appears on screen.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
                    <mxGeometry height="290" width="520" x="-1210" y="-1820" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>