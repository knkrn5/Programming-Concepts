                <mxCell id="46" parent="44" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="2. Loading handling: - the server component loading can be handled at page level specific" vertex="1">
                    <mxGeometry height="50" width="310" y="70" as="geometry"/>
