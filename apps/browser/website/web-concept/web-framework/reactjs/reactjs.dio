                </mxCell>
                <mxCell id="18" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=default;fillColor=none;" value="&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;strong&gt;React Router&lt;/strong&gt; (or whatever router) intercepts it — no real browser navigation happens&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;It reads &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;window.location.pathname&lt;/code&gt; (e.g. &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;/dashboard&lt;/code&gt;)&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;It calls &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;ReactDOM&lt;/code&gt; to &lt;strong&gt;unmount&lt;/strong&gt; the current component tree and &lt;strong&gt;mount&lt;/strong&gt; a new one&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;The DOM updates — looks like a new page, but it&#39;s just JS swapping components&lt;/li&gt;" vertex="1">
