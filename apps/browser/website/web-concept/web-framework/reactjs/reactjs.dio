                <mxCell id="17" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=default;fillColor=none;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;In react, except index.html&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(192, 192, 192), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;color: rgb(192, 192, 192);&quot;&gt;There are no real pages. It&#39;s all &lt;/span&gt;&lt;strong style=&quot;color: rgb(192, 192, 192);&quot;&gt;JavaScript DOM manipulatio&lt;/strong&gt;&lt;/font&gt;&lt;strong style=&quot;color: rgb(192, 192, 192);&quot;&gt;n&lt;/strong&gt;&lt;span style=&quot;color: rgb(192, 192, 192);&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
