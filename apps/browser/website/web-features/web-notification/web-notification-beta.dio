                <mxCell id="ezNY8p4XwQkdJzBVu-HM-162" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#fad7ac;strokeColor=#b46504;" value="push infra server" vertex="1">
                    <mxGeometry height="80" width="410" x="-1503" y="630" as="geometry">
