                        <mxRectangle height="30" width="100" x="-20" y="-980" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="S12gfAqzzEclAbF5FXtb-112" parent="S12gfAqzzEclAbF5FXtb-111" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;b&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: light-dark(rgb(255, 255, 255), rgb(102, 0, 102));&quot;&gt;1. Notification is something that comes Outside of our application, &lt;/font&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;even when our applicaiton is not running&lt;/font&gt;&lt;/b&gt;" vertex="1">
                    <mxGeometry height="60" width="454.88" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="S12gfAqzzEclAbF5FXtb-113" parent="S12gfAqzzEclAbF5FXtb-111" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;b&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: light-dark(rgb(255, 255, 255), rgb(102, 0, 51));&quot;&gt;2. Thatswhy we need some Identification, that wil&lt;/font&gt;&lt;span&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;l&lt;/font&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; identify the user&#39;s device/Browser/app unique to per application&lt;/font&gt;&lt;/span&gt;&lt;/b&gt;" vertex="1">
                    <mxGeometry height="60" width="454.88" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="37" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#d0cee2;strokeColor=#56517e;" value="Identity Verificaiton" vertex="1">
                    <mxGeometry height="380" width="350" x="120" y="750" as="geometry">
                        <mxRectangle height="30" width="140" x="-300" y="732.5" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="68" parent="37" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1.&lt;/font&gt;The browser creates a subscription (with the push service&#39;s infrastructure) by sending it our server&#39;s public key,&lt;div&gt;&lt;ol&gt;&lt;li&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;The push services send the&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 102, 51));&quot;&gt; globally unique subscribtion token&lt;/span&gt; back to the browser, after storing in their database&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;Then this subscribtion token need to be stored by our server to send the push event to that browser later on&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(255, 255, 255), rgb(255, 255, 255));&quot;&gt;The server &lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;public key is used by the&lt;/span&gt;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 76, 153));&quot;&gt;&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt; &lt;/span&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30);&quot;&gt;push services &lt;/font&gt;&lt;/span&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30);&quot;&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;for &lt;/span&gt;&amp;nbsp;verifing the&amp;nbsp; jwt sent by our server signed with private key, thus proving the server identify&lt;/font&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="190" width="350" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="70" parent="37" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2. Now the each and every application/sites&amp;nbsp;&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(51, 0, 102));&quot;&gt;subscription token itself will have its own public and private key&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Now this sub public key is sent to the server, for encrypting the payload&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;And this sub private key is securely store in the browser, used to&amp;nbsp; decrypt the payload&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="160" width="350" y="220" as="geometry"/>
                </mxCell>
