                </mxCell>
                <mxCell id="52" edge="1" parent="1" source="33" style="edgeStyle=none;html=1;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=-0.003;entryY=0.047;entryDx=0;entryDy=0;entryPerimeter=0;" target="47">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="33" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#a20025;fontColor=#ffffff;strokeColor=#6F0000;" value="About the endpoint" vertex="1">
                    <mxGeometry height="680" width="540" x="3040" y="-95" as="geometry"/>
                </mxCell>
                <mxCell id="34" parent="33" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="W3C Push API standard" vertex="1">
                    <mxGeometry height="60" width="540" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="53" parent="33" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="The &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;endpoint&lt;/code&gt; is unique per &lt;strong&gt;(browser instance + origin + service worker subscription)&lt;/strong&gt; — not per user. That means:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Every time a different browser/profile calls &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;.subscribe()&lt;/code&gt;, Google&#39;s FCM backend mints a brand-new unique registration ID and endpoint — even though they&#39;re all using the identical &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;applicationServerKey&lt;/code&gt;.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="110" width="540" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="35" parent="33" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="The subscription stays valid &lt;strong&gt;indefinitely&lt;/strong&gt; as long as:&lt;br&gt;&lt;ol class=&quot;[li_&amp;amp;]:mb-0 [li_&amp;amp;]:mt-1 [li_&amp;amp;]:gap-1 [&amp;amp;:not(:last-child)_ul]:pb-1 [&amp;amp;:not(:last-child)_ol]:pb-1 list-decimal flex flex-col gap-1 pl-8 mb-3 print:block print:space-y-1&quot; dir=&quot;ltr&quot;&gt;&lt;br&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;The user doesn&#39;t uninstall/clear the PWA or clear site data&lt;/li&gt;&lt;br&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;The service worker registration isn&#39;t unregistered&lt;/li&gt;&lt;br&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;Chrome doesn&#39;t internally rotate the underlying FCM token (which it can do periodically, silently, for its own key-management reasons — usually every few months, but there&#39;s no published fixed interval)&lt;/li&gt;&lt;br&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;br&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
                    <mxGeometry height="230" width="540" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="45" parent="33" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="If the browser rotates the token internally, your &lt;strong&gt;old subscription becomes invalid&lt;/strong&gt; and sending to it returns a &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;410 Gone &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 51, 102));&quot;&gt;(if google know url is not present in the google api databsae&lt;/span&gt;)&lt;/code&gt; or &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;404 Not Found (&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 153, 153));&quot;&gt;url is present in the google api database, but the browser instance, never suceeded with response&lt;/span&gt;)&lt;/code&gt; from FCM." vertex="1">
                    <mxGeometry height="80" width="540" y="430" as="geometry"/>
                </mxCell>
                <mxCell id="46" parent="33" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Yes — that endpoint URL is itself a pointer into Google&#39;s infrastructure, not just an opaque string.&lt;/font&gt;&lt;/p&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;&lt;strong&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;How it works on Google&#39;s side:&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;ul class=&quot;[li_&amp;amp;]:mb-0 [li_&amp;amp;]:mt-1 [li_&amp;amp;]:gap-1 [&amp;amp;:not(:last-child)_ul]:pb-1 [&amp;amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3 print:block print:space-y-1&quot; dir=&quot;ltr&quot;&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;fcm.googleapis.com/fcm/send/&amp;lt;registration-id&amp;gt;&lt;/code&gt; — that &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;&amp;lt;registration-id&amp;gt;&lt;/code&gt; (the long token after &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;/send/&lt;/code&gt;) is a key into Google&#39;s FCM backend database, mapping it to: the specific browser instance, the origin (your &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;localhost:5173&lt;/code&gt; / eventually &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;printcampus.in&lt;/code&gt;), the associated public key (&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;p256dh&lt;/code&gt;), and delivery routing info.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
                    <mxGeometry height="170" width="540" y="510" as="geometry"/>
                </mxCell>
                <mxCell id="47" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;" value="About the endpoint" vertex="1">
                    <mxGeometry height="160" width="540" x="3740" y="-110" as="geometry"/>
                </mxCell>
                <mxCell id="49" parent="47" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;strong&gt;VAPID keys&lt;/strong&gt; = your app&#39;s identity card (&quot;this push is authorized by printcampus.in&#39;s backend&quot;)&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;strong&gt;Subscription (&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;endpoint&lt;/code&gt; + &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;p256dh&lt;/code&gt; + &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;auth&lt;/code&gt;)&lt;/strong&gt; = the individual rider&#39;s mailbox address + encryption keys&lt;/li&gt;" vertex="1">
                    <mxGeometry height="90" width="540" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="74" parent="47" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" value="1. Create Public key and Private key: -" vertex="1">
                    <mxGeometry height="40" width="540" y="120" as="geometry"/>
                </mxCell>
                <mxCell id="18" edge="1" parent="1" source="15" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="17">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Before VAPID, browser push services had no way to know who was sending a push message or to rate-limit/contact a sender if something went wrong. VAPID fixes this by having your server sign each push request with a private key, so the push service can verify it came from you." vertex="1">
                    <mxGeometry height="101" width="440" x="1180" y="951" as="geometry"/>
                </mxCell>
                <mxCell id="17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;&lt;strong&gt;The key pair&lt;/strong&gt;&lt;/p&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;You generate one ECDSA key pair (P-256 curve) for your entire application:&lt;/p&gt;&lt;br/&gt;&lt;ul class=&quot;[li_&amp;amp;]:mb-0 [li_&amp;amp;]:mt-1 [li_&amp;amp;]:gap-1 [&amp;amp;:not(:last-child)_ul]:pb-1 [&amp;amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3 print:block print:space-y-1&quot; dir=&quot;ltr&quot;&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;strong&gt;Public key&lt;/strong&gt;: sent to the browser when you call &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;pushManager.subscribe()&lt;/code&gt;. It gets baked into the subscription — the push service (e.g. Google&#39;s FCM endpoint) associates this public key with that specific subscription.&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;strong&gt;Private key&lt;/strong&gt;: stays on your server, never exposed. You use it to sign a JWT for every push message you send.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
                    <mxGeometry height="240" width="460" x="1280" y="1190" as="geometry"/>
                </mxCell>
                <mxCell id="25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;" value="&lt;div class=&quot;relative group/copy bg-bg-000/50 border-0.5 border-border-400 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-100&quot; tabindex=&quot;0&quot; aria-label=&quot;javascript code&quot; role=&quot;group&quot;&gt;&lt;div class=&quot;overflow-x-auto&quot;&gt;&lt;pre style=&quot;color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);&quot; class=&quot;code-block__code !my-0 !rounded-lg !text-sm !leading-relaxed p-3.5&quot;&gt;&lt;code style=&quot;color: rgb(234, 236, 240); background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; font-family: var(--font-mono);&quot; class=&quot;language-javascript&quot;&gt;&lt;span style=&quot;color: rgb(204, 123, 244);&quot;&gt;const&lt;/span&gt; reg = &lt;span style=&quot;color: rgb(204, 123, 244);&quot;&gt;await&lt;/span&gt; navigator&lt;span style=&quot;color: rgb(211, 215, 222);&quot;&gt;.&lt;/span&gt;serviceWorker&lt;span style=&quot;color: rgb(211, 215, 222);&quot;&gt;.&lt;/span&gt;ready&lt;span style=&quot;color: rgb(211, 215, 222);&quot;&gt;;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;navigator.serviceWorker&lt;/code&gt; is a &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;ServiceWorkerContainer&lt;/code&gt; — one per page, tied to the page&#39;s own URL/scope. &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;.ready&lt;/code&gt; is a promise that resolves once &lt;strong&gt;there is an active service worker controlling this page&lt;/strong&gt;. It doesn&#39;t take an argument telling it which SW to wait for — it just looks at whatever registration applies to the current page&#39;s scope.&lt;/p&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;Since &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;sw1.js&lt;/code&gt; was the only thing registered for this page, and its scope covers this page, &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;.ready&lt;/code&gt; resolves to &lt;em&gt;that same registration&lt;/em&gt; — same object, in effect, as what &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;register(&quot;./sw/sw1.js&quot;)&lt;/code&gt; created. That&#39;s the connection: &lt;strong&gt;implicit, via scope-matching done internally by the browser&lt;/strong&gt;, not via a shared JS variable.&lt;/p&gt;" vertex="1">
                    <mxGeometry height="300" width="450" x="-1520" y="1260" as="geometry"/>
                </mxCell>
                <mxCell id="30" edge="1" parent="1" source="26" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="29">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;" value="&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;subsciption from client {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; endpoint: &#39;https://fcm.googleapis.com/fcm/send/dphHUAZG9LQ:APA91bGR8qt9086EX20N9rEzsW4UZZuMB6EeVBdAW94G7Wm961N1e-KXL68YNb8H1g2bKf-EEH3_-u688URINMgrkUL0EZEUkIYb9CxidysXqgBBXxHe04AgV6XpQE9JO6SuOGd5zX8M&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; expirationTime: null,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; keys: {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; p256dh: &#39;BNTJAPCYSOPj7eypci0apHUmXw5xtQ3cIV-u1x0QOOzuY4g7rYPUZJAV3U3wD2mEYvxFS2kD5_b6qwMJPxAZ4zM&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; auth: &#39;bMi0PudivoMoOnWaHwZvsw&#39;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; endpoint: &#39;https://updates.push.services.mozilla.com/wpush/v2/gAAAAABqegYuRrhLQEWnk1VJ4pKNpFDcquzN_n5UHEYmCGPj1HjVZKMieqWbrQsFckI4IPcjAKi_5HHEeLk8_WwyuhlrI3KDj1VmGu-d9PkfpZUwTK_2Hkk9auwEBoF7AQkkpyd7lkKFJ1dRND9d6ekhMdQSpsXCzYZ-Vw5UDhDS5usKsM__xpE&#39;,&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; expirationTime: null,&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; keys: {&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; auth: &#39;o-AHqxxOM6wRwaDlOeLEeA&#39;,&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; p256dh: &#39;BDvbFE0Xmc6BXfGu64mpz4z4BW0xj6ldg2COrIJyEKwLCyvJYnhIAxnoJ-q8Ih4xzDNpsPqNlBgExhQKWosfV50&#39;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; }&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
                    <mxGeometry height="315" width="670" x="2220" y="-52.5" as="geometry"/>
                </mxCell>
                <mxCell id="29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;&lt;strong&gt;Why storage is unavoidable here&lt;/strong&gt;&lt;/p&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;Push is fundamentally different from something like a WebSocket where the connection &lt;em&gt;is&lt;/em&gt; the identity — here, the browser generates this subscription once at subscribe-time and then goes silent. Your server has no live connection to the client at all. The &lt;em&gt;only&lt;/em&gt; way to reach a specific rider later (say, when their order status changes) is to already have their subscription object sitting in your DB, looked up by &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;riderId&lt;/code&gt;.&lt;/p&gt;" vertex="1">
                    <mxGeometry height="180" width="450" x="2430" y="370" as="geometry"/>
                </mxCell>
