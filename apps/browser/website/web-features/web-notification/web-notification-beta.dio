                    <mxGeometry height="150" width="410" x="-440" y="1335" as="geometry">
                        <mxRectangle height="30" width="90" x="-220" y="507.5" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="94" parent="ezNY8p4XwQkdJzBVu-HM-115" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;fontColor=light-dark(#FFFFFF,#FFFFFF);" value="1. In browser, each service worker are registered to per scope/domain&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;one specific brower + origin/domain + service worker&lt;/div&gt;" vertex="1">
                    <mxGeometry height="70" width="410" y="30" as="geometry"/>
