                <mxCell id="58" value="Get unique token" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="56" vertex="1">
                    <mxGeometry y="80" width="410" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="59" value="Subscriber event: - onMessage&lt;br&gt;publisher:- BTS push api (firebase admin sdk)" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="56" vertex="1">
                    <mxGeometry y="120" width="410" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="60" value="Token invalidation → Firebase Admin SDK throws &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;messaging/registration-token-not-registered&lt;/code&gt; instead of raw &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;410 Gone&lt;/code&gt;, so update your error handling:" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="56" vertex="1">
                    <mxGeometry y="160" width="410" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="52" style="edgeStyle=none;html=1;exitX=1;exitY=0;exitDx=0;exitDy=0;entryX=-0.003;entryY=0.047;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="33" target="47" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="33" value="About the endpoint" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#a20025;fontColor=#ffffff;strokeColor=#6F0000;" parent="1" vertex="1">
                    <mxGeometry x="2230" y="465" width="540" height="680" as="geometry"/>
                </mxCell>
                <mxCell id="34" value="W3C Push API standard" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="33" vertex="1">
                    <mxGeometry y="30" width="540" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="53" value="The &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;endpoint&lt;/code&gt; is unique per &lt;strong&gt;(browser instance + origin + service worker subscription)&lt;/strong&gt; — not per user. That means:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Every time a different browser/profile calls &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;.subscribe()&lt;/code&gt;, Google&#39;s FCM backend mints a brand-new unique registration ID and endpoint — even though they&#39;re all using the identical &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;applicationServerKey&lt;/code&gt;.&lt;/div&gt;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="33" vertex="1">
                    <mxGeometry y="90" width="540" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="35" value="The subscription stays valid &lt;strong&gt;indefinitely&lt;/strong&gt; as long as:&lt;br/&gt;&lt;ol class=&quot;[li_&amp;amp;]:mb-0 [li_&amp;amp;]:mt-1 [li_&amp;amp;]:gap-1 [&amp;amp;:not(:last-child)_ul]:pb-1 [&amp;amp;:not(:last-child)_ol]:pb-1 list-decimal flex flex-col gap-1 pl-8 mb-3 print:block print:space-y-1&quot; dir=&quot;ltr&quot;&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;The user doesn&#39;t uninstall/clear the PWA or clear site data&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;The service worker registration isn&#39;t unregistered&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;Chrome doesn&#39;t internally rotate the underlying FCM token (which it can do periodically, silently, for its own key-management reasons — usually every few months, but there&#39;s no published fixed interval)&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;The user doesn&#39;t revoke notification permission&lt;/li&gt;&lt;/ol&gt;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="33" vertex="1">
                    <mxGeometry y="200" width="540" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="45" value="If the browser rotates the token internally, your &lt;strong&gt;old subscription becomes invalid&lt;/strong&gt; and sending to it returns a &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;410 Gone &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 51, 102));&quot;&gt;(if google know url is not present in the google api databsae&lt;/span&gt;)&lt;/code&gt; or &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;404 Not Found (&lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 153, 153));&quot;&gt;url is present in the google api database, but the browser instance, never suceeded with response&lt;/span&gt;)&lt;/code&gt; from FCM." style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="33" vertex="1">
                    <mxGeometry y="430" width="540" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="46" value="&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Yes — that endpoint URL is itself a pointer into Google&#39;s infrastructure, not just an opaque string.&lt;/font&gt;&lt;/p&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;&lt;strong&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;How it works on Google&#39;s side:&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;ul class=&quot;[li_&amp;amp;]:mb-0 [li_&amp;amp;]:mt-1 [li_&amp;amp;]:gap-1 [&amp;amp;:not(:last-child)_ul]:pb-1 [&amp;amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3 print:block print:space-y-1&quot; dir=&quot;ltr&quot;&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;fcm.googleapis.com/fcm/send/&amp;lt;registration-id&amp;gt;&lt;/code&gt; — that &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;&amp;lt;registration-id&amp;gt;&lt;/code&gt; (the long token after &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;/send/&lt;/code&gt;) is a key into Google&#39;s FCM backend database, mapping it to: the specific browser instance, the origin (your &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;localhost:5173&lt;/code&gt; / eventually &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;printcampus.in&lt;/code&gt;), the associated public key (&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;p256dh&lt;/code&gt;), and delivery routing info.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="33" vertex="1">
                    <mxGeometry y="510" width="540" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="47" value="About the endpoint" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;" parent="1" vertex="1">
                    <mxGeometry x="2930" y="450" width="540" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="48" value="&lt;p&gt;so that means i can use the same public key for each and every users to send the notificaiton specifically , i was thinking that i would need the sperate public key for all&lt;/p&gt;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="47" vertex="1">
                    <mxGeometry y="30" width="540" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="49" value="&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;strong&gt;VAPID keys&lt;/strong&gt; = your app&#39;s identity card (&quot;this push is authorized by printcampus.in&#39;s backend&quot;)&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;strong&gt;Subscription (&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;endpoint&lt;/code&gt; + &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;p256dh&lt;/code&gt; + &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;auth&lt;/code&gt;)&lt;/strong&gt; = the individual rider&#39;s mailbox address + encryption keys&lt;/li&gt;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="47" vertex="1">
                    <mxGeometry y="100" width="540" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="event based actions" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="-730" y="670" width="270" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="13" value="1. send&lt;div&gt;2. if notification clicked&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="12" vertex="1">
                    <mxGeometry y="30" width="270" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="19" value="Notification core concept" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;rounded=1;fillColor=#008a00;fontColor=#ffffff;strokeColor=#005700;" parent="1" vertex="1">
                    <mxGeometry x="110" y="1010" width="320" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="&lt;div&gt;client: - client should continueously, listening ot the endpoint&lt;/div&gt;&lt;div&gt;1. sse&lt;/div&gt;&lt;div&gt;2. web socket&lt;/div&gt;&lt;div&gt;limitation will not work in the background or when the tab is closed&lt;/div&gt;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="19" vertex="1">
                    <mxGeometry y="30" width="320" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="21" value="Browser: - Identifing the notication is comming from which applicaiton: -&amp;nbsp;&lt;div&gt;Protection against our push endpoint misuse&lt;/div&gt;" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="19" vertex="1">
                    <mxGeometry y="120" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="Application: - boardcast&amp;nbsp; and unicast to specifc user (how to identify specific user)" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="19" vertex="1">
                    <mxGeometry y="170" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="61" value="why per browser and not every user logged in a same browser" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="19" vertex="1">
                    <mxGeometry y="220" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="9" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="7" target="8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="Each browser vendor runs (or delegates to) its own &lt;strong&gt;push service&lt;/strong&gt; — a persistent server infrastructure that maintains an open connection with the browser, even when your site isn&#39;t open. Your app never talks to this push service directly for delivery; it&#39;s the browser&#39;s job.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Your backend ──push message──&amp;gt; Vendor&#39;s Push Service ──delivers──&amp;gt; Browser (always connected)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="889" y="620" width="390" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="&amp;nbsp;FCM abstracts this away for Chromium, but if you want push to genuinely reach Firefox and Safari users too, &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;firebase-admin&lt;/code&gt;&#39;s &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;messaging().send()&lt;/code&gt; actually handles routing through the right vendor infra behind the scenes when you use &lt;strong&gt;Web Push protocol via FCM&lt;/strong&gt;, since FCM now supports sending push to any browser&#39;s endpoint, not just Chrome. So you likely don&#39;t need to write separate integration code per browser — but it&#39;s still good to know the requests are terminating in different vendor infrastructure." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="880" y="850" width="430" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="18" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="15" target="17" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="Before VAPID, browser push services had no way to know who was sending a push message or to rate-limit/contact a sender if something went wrong. VAPID fixes this by having your server sign each push request with a private key, so the push service can verify it came from you." style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-1060" y="880" width="440" height="101" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;&lt;strong&gt;The key pair&lt;/strong&gt;&lt;/p&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;You generate one ECDSA key pair (P-256 curve) for your entire application:&lt;/p&gt;&lt;br/&gt;&lt;ul class=&quot;[li_&amp;amp;]:mb-0 [li_&amp;amp;]:mt-1 [li_&amp;amp;]:gap-1 [&amp;amp;:not(:last-child)_ul]:pb-1 [&amp;amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3 print:block print:space-y-1&quot; dir=&quot;ltr&quot;&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;strong&gt;Public key&lt;/strong&gt;: sent to the browser when you call &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;pushManager.subscribe()&lt;/code&gt;. It gets baked into the subscription — the push service (e.g. Google&#39;s FCM endpoint) associates this public key with that specific subscription.&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;strong&gt;Private key&lt;/strong&gt;: stays on your server, never exposed. You use it to sign a JWT for every push message you send.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-1050" y="1051" width="460" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="23" value="VAPID (Voluntary Application Server Identification) keys are how a &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 51, 102));&quot;&gt;push server identifies&lt;/span&gt; itself to &lt;span style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 153, 153));&quot;&gt;push services (like Chrome&#39;s or Firefox&#39;s push servers)&lt;/span&gt; without needing to register per-app with each browser vendor." style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="1" vertex="1">
                    <mxGeometry x="510" y="1160" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="24" style="edgeStyle=none;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="21" target="23" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="25" value="&lt;div class=&quot;relative group/copy bg-bg-000/50 border-0.5 border-border-400 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-100&quot; tabindex=&quot;0&quot; aria-label=&quot;javascript code&quot; role=&quot;group&quot;&gt;&lt;div class=&quot;overflow-x-auto&quot;&gt;&lt;pre style=&quot;color: rgb(234, 236, 240); background: transparent; font-family: var(--font-mono);&quot; class=&quot;code-block__code !my-0 !rounded-lg !text-sm !leading-relaxed p-3.5&quot;&gt;&lt;code style=&quot;color: rgb(234, 236, 240); background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; font-family: var(--font-mono);&quot; class=&quot;language-javascript&quot;&gt;&lt;span style=&quot;color: rgb(204, 123, 244);&quot;&gt;const&lt;/span&gt; reg = &lt;span style=&quot;color: rgb(204, 123, 244);&quot;&gt;await&lt;/span&gt; navigator&lt;span style=&quot;color: rgb(211, 215, 222);&quot;&gt;.&lt;/span&gt;serviceWorker&lt;span style=&quot;color: rgb(211, 215, 222);&quot;&gt;.&lt;/span&gt;ready&lt;span style=&quot;color: rgb(211, 215, 222);&quot;&gt;;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;&lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;navigator.serviceWorker&lt;/code&gt; is a &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;ServiceWorkerContainer&lt;/code&gt; — one per page, tied to the page&#39;s own URL/scope. &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;.ready&lt;/code&gt; is a promise that resolves once &lt;strong&gt;there is an active service worker controlling this page&lt;/strong&gt;. It doesn&#39;t take an argument telling it which SW to wait for — it just looks at whatever registration applies to the current page&#39;s scope.&lt;/p&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;Since &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;sw1.js&lt;/code&gt; was the only thing registered for this page, and its scope covers this page, &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;.ready&lt;/code&gt; resolves to &lt;em&gt;that same registration&lt;/em&gt; — same object, in effect, as what &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;register(&quot;./sw/sw1.js&quot;)&lt;/code&gt; created. That&#39;s the connection: &lt;strong&gt;implicit, via scope-matching done internally by the browser&lt;/strong&gt;, not via a shared JS variable.&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;" parent="1" vertex="1">
                    <mxGeometry x="-400" y="770" width="450" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="30" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="26" target="29" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="26" value="&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;subsciption from client {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; endpoint: &#39;https://fcm.googleapis.com/fcm/send/dphHUAZG9LQ:APA91bGR8qt9086EX20N9rEzsW4UZZuMB6EeVBdAW94G7Wm961N1e-KXL68YNb8H1g2bKf-EEH3_-u688URINMgrkUL0EZEUkIYb9CxidysXqgBBXxHe04AgV6XpQE9JO6SuOGd5zX8M&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; expirationTime: null,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; keys: {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; p256dh: &#39;BNTJAPCYSOPj7eypci0apHUmXw5xtQ3cIV-u1x0QOOzuY4g7rYPUZJAV3U3wD2mEYvxFS2kD5_b6qwMJPxAZ4zM&#39;,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; auth: &#39;bMi0PudivoMoOnWaHwZvsw&#39;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;}&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; endpoint: &#39;https://updates.push.services.mozilla.com/wpush/v2/gAAAAABqegYuRrhLQEWnk1VJ4pKNpFDcquzN_n5UHEYmCGPj1HjVZKMieqWbrQsFckI4IPcjAKi_5HHEeLk8_WwyuhlrI3KDj1VmGu-d9PkfpZUwTK_2Hkk9auwEBoF7AQkkpyd7lkKFJ1dRND9d6ekhMdQSpsXCzYZ-Vw5UDhDS5usKsM__xpE&#39;,&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; expirationTime: null,&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; keys: {&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; auth: &#39;o-AHqxxOM6wRwaDlOeLEeA&#39;,&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; p256dh: &#39;BDvbFE0Xmc6BXfGu64mpz4z4BW0xj6ldg2COrIJyEKwLCyvJYnhIAxnoJ-q8Ih4xzDNpsPqNlBgExhQKWosfV50&#39;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; }&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; }&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;" parent="1" vertex="1">
                    <mxGeometry x="1410" y="507.5" width="670" height="315" as="geometry"/>
                </mxCell>
                <mxCell id="27" value="Their comes the use of public key and private key" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" parent="1" vertex="1">
                    <mxGeometry x="-270" y="1130" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="28" style="edgeStyle=none;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="21" target="27" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="32" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="29" target="31" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="29" value="&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;&lt;strong&gt;Why storage is unavoidable here&lt;/strong&gt;&lt;/p&gt;&lt;br/&gt;&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;Push is fundamentally different from something like a WebSocket where the connection &lt;em&gt;is&lt;/em&gt; the identity — here, the browser generates this subscription once at subscribe-time and then goes silent. Your server has no live connection to the client at all. The &lt;em&gt;only&lt;/em&gt; way to reach a specific rider later (say, when their order status changes) is to already have their subscription object sitting in your DB, looked up by &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;riderId&lt;/code&gt;.&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1630" y="925" width="450" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="31" value="&lt;p dir=&quot;ltr&quot; class=&quot;font-claude-response-body break-words whitespace-normal&quot;&gt;&lt;strong&gt;Two things worth planning for since you&#39;re storing these long-term&lt;/strong&gt;&lt;/p&gt;&lt;br/&gt;&lt;ol class=&quot;[li_&amp;amp;]:mb-0 [li_&amp;amp;]:mt-1 [li_&amp;amp;]:gap-1 [&amp;amp;:not(:last-child)_ul]:pb-1 [&amp;amp;:not(:last-child)_ol]:pb-1 list-decimal flex flex-col gap-1 pl-8 mb-3 print:block print:space-y-1&quot; dir=&quot;ltr&quot;&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;strong&gt;One rider, multiple subscriptions.&lt;/strong&gt; If a rider opens your rider-web-app on both their phone and a desktop browser, each is a &lt;em&gt;separate&lt;/em&gt; subscription (different endpoint/keys). Store as one-to-many, not one-to-one, or you&#39;ll silently overwrite one device&#39;s subscription with another&#39;s.&lt;/li&gt;&lt;br/&gt;&lt;li class=&quot;font-claude-response-body whitespace-normal break-words pl-2&quot;&gt;&lt;strong&gt;Subscriptions expire/die silently.&lt;/strong&gt; Push services return &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;410 Gone&lt;/code&gt; (or sometimes &lt;code class=&quot;bg-text-200/5 border border-0.5 border-border-300 text-danger-000 whitespace-pre-wrap rounded-[0.4rem] px-1 py-px text-[0.9rem]&quot;&gt;404&lt;/code&gt;) when a subscription is no longer valid (user cleared site data, uninstalled, browser revoked it, etc.). You won&#39;t know until you try to send — so on that response code, delete the row from your DB rather than retrying it forever.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="1610" y="1215" width="530" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="36" style="edgeStyle=none;html=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.003;entryY=0.167;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="26" target="33" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="55" style="edgeStyle=none;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" parent="1" source="44" target="25" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="62" value="&lt;div&gt;the browser itself maintains the persistent connection, not your website&#39;s tab.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;it opens &lt;em&gt;one&lt;/em&gt; persistent connection to Google&#39;s push infrastructure (FCM at the transport level" style="text;strokeColor=default;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=1 4;" vertex="1" parent="1">
                    <mxGeometry x="520" y="990" width="320" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="63" style="edgeStyle=none;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="20" target="62">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>